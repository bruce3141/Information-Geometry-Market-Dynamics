.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# ============================================================================
# Virtual environments
# ============================================================================
.venv/
venv/
env/
ENV/
.env
.env.local

# uv / poetry / pipenv lock artifacts that users regenerate themselves
.python-version
Pipfile.lock
poetry.lock
uv.lock

# ============================================================================
# Jupyter
# ============================================================================
.ipynb_checkpoints/
*.ipynb_checkpoints

# ============================================================================
# macOS
# ============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon
.DocumentRevisions-V100
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Files that might appear from AirDrop or Finder preview
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# ============================================================================
# Editors / IDEs
# ============================================================================
# VS Code
.vscode/
*.code-workspace

# PyCharm / IntelliJ
.idea/
*.iml
*.iws

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.\#*

# ============================================================================
# LaTeX / PDF build byproducts
# (the pdf itself is tracked; we ignore only the intermediates)
# ============================================================================
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.nav
*.snm
*.vrb
*.bbl
*.blg
*.run.xml
*.bcf

# pandoc build intermediate generated by scripts/build_pdf.py
paper/*_build.md

# ============================================================================
# Data / large artifacts that should not be in git
# ============================================================================
# Databento or other proprietary price data that can't be redistributed
*.dbn
*.dbn.zst
data/raw/
data/databento/

# Transient yfinance cache that appears if users run the scripts
yfinance.cache

# Notebook outputs as standalone HTML / ipynb you might export
*.html.bak

# ============================================================================
# Project-specific
# ============================================================================
# Draft scratch files -- prefix with scratch_ to exempt from tracking
scratch_*
*.scratch
notes_local.md
TODO_local.md
